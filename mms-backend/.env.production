NODE_ENV=production

PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mms
DB_USER=postgres
# REQUIRED: set the actual PostgreSQL password before deploying
DB_PASSWORD=

# REQUIRED: use a strong random value in production (min 32 chars)
JWT_SECRET=mms123
JWT_EXPIRES_IN=24h

# REQUIRED: set to the actual server address browsers use to reach this app
# e.g. http://192.168.1.50 or http://mms.yourcompany.com
# With Nginx on port 80 serving both frontend and /api, same-origin requests
# do not send an Origin header, so CORS is only relevant for direct API access.
CORS_ORIGIN=http://localhost

REPORT_SERVICE_BASE_URL=http://localhost:8085
REPORT_SERVICE_RENDER_PATH=/reports/render
REPORT_SERVICE_TIMEOUT_MS=120000